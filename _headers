/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://*.sender.net; img-src 'self' data: https://*.sender.net; style-src 'self' 'unsafe-inline' https://*.sender.net; script-src 'self' 'unsafe-inline' https://cdn.sender.net; frame-src https://*.sender.net; base-uri 'self'; form-action 'self' https://*.sender.net; frame-ancestors 'none'; upgrade-insecure-requests

